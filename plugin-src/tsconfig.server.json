{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "./target",
    "rootDir": "./"
  },
  "include": ["server/**/*", "common/**/*"],
  "exclude": ["node_modules", "target", "public"]
}
